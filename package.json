{
  "name": "swqbot",
  "private": true,
  "type": "module",
  "version": "1.0.214",
  "description": "swqbot - Stake automation desktop app",
  "author": "swqbot",
  "repository": {
    "type": "git",
    "url": "https://github.com/swqstake-bot/sportslots.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"tsc -p electron/tsconfig.json -w\" \"wait-on tcp:5176 && cross-env VITE_DEV_SERVER_URL=http://localhost:5176 electron .\"",
    "generate:icons": "node scripts/generate-brand-icons.mjs",
    "build:compile": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "package": "npm run build:compile && electron-packager . --overwrite --out=release-final --platform=win32 --arch=x64 --prune=true --asar --extra-resource=app-update.yml --ignore=\"^/(src|electron|tsconfig|vite\\.config|\\.git|\\.gitignore|README|LICENSE|builder-cache|release|release_old|release-packager|release-final)\"",
    "build": "npm run build:compile && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "build:publish": "npm run build:compile && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish always",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "qa:contracts": "node scripts/qa/contract-harness.mjs",
    "qa:replay": "node scripts/qa/replay-harness.mjs",
    "qa:gate": "npm run qa:contracts && npm run qa:replay && npm run test",
    "project-analysis:inventory": "node scripts/project-analysis/generate-inventory.mjs",
    "project-analysis:symbols": "node scripts/project-analysis/extract-symbols.mjs",
    "project-analysis:all": "npm run project-analysis:inventory && npm run project-analysis:symbols"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-virtual": "^3.13.23",
    "autoprefixer": "^10.4.24",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.34.3",
    "graphql-ws": "^6.0.7",
    "node-fetch": "^3.3.2",
    "pako": "^2.1.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "telegram": "^2.26.22",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.swqbot.electron",
    "productName": "swqbot",
    "directories": {
      "output": "release-final",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "swqstake-bot",
        "repo": "sportslots",
        "releaseType": "release"
      }
    ]
  }
}
